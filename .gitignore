# Archivos y carpetas a ignorar para el repositorio Git

# Entornos virtuales
.venv/
env/
venv/

# Datos del corpus: solo se sube el corpus de entrenamiento, el resto queda local
datos/*
!datos/corpus_ApAvAu.txt

# Carpeta de respaldos y checkpoints .npz (archivos pesados de pesos)
respaldos/**
*.npz

# Excepciones: se suben los resultados livianos (métricas, tablas, gráficos, logs)
# y los pesos chicos que hacen falta para reproducir el TP2.
# Los demás .npz quedan locales: son 8,7 GB y GitHub rechaza archivos de más de 100 MB.
!respaldos/**/
!respaldos/**/*.csv
!respaldos/**/*.md
!respaldos/**/*.png
!respaldos/**/*.log
!respaldos/modelo_cbow_w4_epoca_254.npz
!respaldos/microgpt/**/*.npz

# Documentos locales de desarrollo solicitados para ignorar
rules.md
bitacora.md

# Archivos de cache de Python y Jupyter
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/
*.egg-info/

